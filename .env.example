# Copy settings into the process environment; .env is not loaded automatically.
# Replace empty required values locally. Never commit real secrets.
DSH_PHALANX_SESSION_SECRET=
DSH_PHALANX_RUNTIME_COMMAND=node
DSH_PHALANX_RUNTIME_ARGS_JSON='["/path/to/built-dsh/apps/cli/lib/bin.js","--profile","web"]'
DSH_PHALANX_DATA_ROOT=.data
DSH_PHALANX_HOST=127.0.0.1
DSH_PHALANX_PORT=3000
DSH_PHALANX_ALLOWED_MODEL_PROVIDER=deepseek-official
DSH_PHALANX_ALLOWED_MODEL=deepseek-chat
DSH_PHALANX_MODEL_UPSTREAM_BASE_URL=https://api.deepseek.com
DSH_PHALANX_MODEL_UPSTREAM_API_KEY=
DSH_PHALANX_REGISTRATION_ENABLED=false
DSH_PHALANX_IDLE_RECLAIM_SECONDS=1800
# Container mode only:
# DSH_PHALANX_CONTAINER_IMAGE=your-pinned-instance-image
# DSH_PHALANX_CONTAINER_RUNTIME=podman
# DSH_PHALANX_HOST_PUBLIC_ADDRESSES=your-complete-public-ipv4-inventory
