# A dedicated unprivileged nginx process; paths are deployment-owned examples.
# Render deployment values before validation; keep real IPs and keys out of Git.
worker_processes auto;
pid /run/dsh-phalanx-edge/nginx.pid;
error_log stderr warn;
events { worker_connections 1024; }
http {
    access_log off;
    client_body_temp_path /run/dsh-phalanx-edge/client;
    proxy_temp_path /run/dsh-phalanx-edge/proxy;
    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }
    server {
        listen 18443 ssl;
        server_name 198.51.100.10;
        ssl_certificate /etc/dsh-phalanx-edge/server.crt;
        ssl_certificate_key /etc/dsh-phalanx-edge/server.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        client_max_body_size 0;
        location / {
            proxy_pass http://127.0.0.1:18080;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_buffering off;
            proxy_read_timeout 3600s;
        }
    }
}
