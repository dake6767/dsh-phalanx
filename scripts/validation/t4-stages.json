{
  "schema": 1,
  "fieldFiles": [
    "package.json",
    "release-policy.json",
    "runtime-versions.json"
  ],
  "versionMetadata": [
    "package.json#version",
    "release-policy.json#compatibility.source",
    "release-policy.json#acceptancePolicy.ticket"
  ],
  "harness": [
    "tests/**",
    "scripts/dev/**",
    "scripts/validation/**",
    ".github/workflows/ci.yml",
    ".github/workflows/cleanup-candidates.yml",
    "scripts/validate-mcp-stream.ts",
    "vitest.e2e.config.ts",
    "releases/acceptance/**"
  ],
  "stageHarness": {
    "vitest.e2e.config.ts": [
      "*"
    ],
    "releases/acceptance/*.json": [
      "smoke"
    ],
    "scripts/validation/t4-baseline.mjs": [
      "smoke",
      "fullUpgrade",
      "offlineTransport"
    ]
  },
  "noStage": [
    "*.md",
    "docs/**",
    "releases/**",
    "LICENSE",
    "NOTICE",
    ".gitignore",
    "admin-ui/.gitignore",
    ".env.example",
    "eslint.config.js",
    "vitest.config.ts",
    "architecture-exemptions.json",
    "scripts/architecture-eslint.mjs",
    "scripts/browser-http-eslint.mjs",
    "scripts/check-*",
    "scripts/fast-check*",
    "scripts/*.d.mts"
  ],
  "allStages": [
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "tsconfig.json",
    "tsconfig.build.json",
    ".node-version",
    ".github/workflows/**",
    "scripts/build-*.mjs",
    "scripts/generate-*.mjs"
  ],
  "stages": [
    {
      "id": "smoke",
      "title": "T4 smoke: formal previous baseline, upgrade, one real DSH reply",
      "always": true,
      "entries": [
        "tests/installed-system-upgrade.e2e.ts"
      ],
      "paths": []
    },
    {
      "id": "fullUpgrade",
      "title": "T4 full upgrade, mainland online, with full after assertions",
      "entries": [
        "tests/installed-system-upgrade.e2e.ts"
      ],
      "paths": [
        "containers/**",
        "runtime/**",
        "runtime-versions.json",
        "release-policy.json#compatibility",
        "install.sh",
        "scripts/install/**",
        "scripts/release/**",
        "scripts/download-sources.py",
        "src/dsh/**",
        "src/composition/**",
        "src/**/*upgrade*",
        "src/**/*system-update*",
        "src/**/*migration*",
        "src/**/*runtime*",
        "src/**/*download-source*",
        "src/**/*container*",
        "src/**/*isolation*",
        "src/**/*process*",
        "src/**/*store*",
        "src/**/*maintenance*",
        "src/adapters/user-storage-*",
        "src/inbound/*proxy*",
        "admin-ui/src/*SystemUpdate*",
        "admin-ui/src/*DownloadSource*"
      ]
    },
    {
      "id": "offlineTransport",
      "title": "T4 offline bundle transport",
      "entries": [
        "tests/installed-system-upgrade.e2e.ts"
      ],
      "paths": [
        "install.sh",
        "scripts/install/bootstrap.sh",
        "scripts/install/installer.py",
        "scripts/install/installer_release.py",
        "scripts/install/installer_executor.py",
        "scripts/install/installer_storage.py",
        "scripts/install/installer_upgrade_cli.py",
        "scripts/install/installer_upgrade_host.py",
        "scripts/release/**",
        "src/**/*system-update*",
        "admin-ui/src/*SystemUpdate*"
      ]
    },
    {
      "id": "native",
      "title": "T4 frozen native real-service batch",
      "entries": [
        "tests/community-shared-models-real.e2e.ts",
        "tests/contributions-real-model-container.e2e.ts",
        "tests/community-mcp-github.e2e.ts",
        "tests/community-mcp-private-samples.e2e.ts",
        "tests/community-mcp-combination.e2e.ts",
        "tests/installed-mcp-market.e2e.ts",
        "tests/installed-mcp-update.e2e.ts",
        "tests/execution-dependency-migration-container.e2e.ts"
      ],
      "paths": [
        "src/**",
        "admin-ui/**",
        "containers/**",
        "runtime/**",
        "runtime-versions.json"
      ]
    },
    {
      "id": "https",
      "title": "T4 HTTPS, preview and WebSocket proxy",
      "entries": [
        "tests/https-preview.e2e.ts"
      ],
      "paths": [
        "deploy/**",
        "install.sh",
        "scripts/install/**",
        "src/composition/**",
        "src/inbound/public-server.ts",
        "src/inbound/http-entry.ts",
        "src/inbound/community-http-entry.ts",
        "src/inbound/community-request.ts",
        "src/inbound/platform-session.ts",
        "src/inbound/*proxy*",
        "src/inbound/*preview*",
        "src/adapters/community-env-config.ts",
        "src/adapters/service-preview-*",
        "src/dsh/*preview*",
        "src/ports/service-preview.ts",
        "src/use-cases/service-preview.ts"
      ]
    },
    {
      "id": "cleanInstall",
      "title": "T4 clean installation VM",
      "entries": [
        "tests/installer-ubuntu.e2e.ts"
      ],
      "paths": [
        "install.sh",
        "scripts/install/**",
        "scripts/release/**",
        "scripts/download-sources.py",
        "runtime-versions.json#!dsh",
        "release-policy.json"
      ]
    }
  ]
}
