{
  "name": "dsh-phalanx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build-service.mjs",
    "dev": "tsx src/composition/cli.ts",
    "lint": "eslint . && node scripts/check-architecture-assets.mjs",
    "start": "node dist/composition/cli.js",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:admin-ui": "corepack pnpm --filter @dsh-phalanx/admin-ui build",
    "test:admin-ui": "corepack pnpm exec vitest run --config vitest.e2e.config.ts tests/community-onboarding.e2e.ts tests/community-account-lifecycle.e2e.ts",
    "check:fast": "node scripts/fast-check.mjs"
  },
  "dependencies": {
    "cookie-es": "3.1.1",
    "http-proxy-3": "2.0.1",
    "ws": "8.21.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.4",
    "@types/ws": "8.18.1",
    "eslint": "9.39.5",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  },
  "license": "Apache-2.0",
  "files": [
    "dist",
    "admin-ui/dist",
    "runtime",
    "runtime-versions.json",
    ".env.example",
    "LICENSE",
    "NOTICE",
    "TRADEMARKS.md",
    "README.md"
  ]
}
